# ---------------------------------------------------------------------------
# Variables d'environnement à configurer dans Vercel (Project > Settings > Environment Variables)
# ---------------------------------------------------------------------------

# --- Backend (Lovable Cloud) : exposé au navigateur, clé PUBLIQUE uniquement ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Même backend, côté serveur (SSR / API du panneau admin) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Compte administrateur du backend : STRICTEMENT côté serveur ---
# Utilisé par le panneau /admin pour écrire dans la base et envoyer les images.
ADMIN_SUPABASE_EMAIL=admin@exemple.com
ADMIN_SUPABASE_PASSWORD=<mot-de-passe-du-compte-admin>

# --- Panneau /admin ---
ADMIN_PASSWORD=simo123
# Chaîne aléatoire de 32+ caractères qui chiffre le cookie de session admin
ADMIN_SESSION_SECRET=<chaine-aleatoire-de-32-caracteres-minimum>

# SUPABASE_SERVICE_ROLE_KEY n'est PAS nécessaire : l'application n'en dépend plus.
